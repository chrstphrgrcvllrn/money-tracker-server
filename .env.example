# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Database
MONGO_URI=

# Auth secrets: each at least 32 random characters, and DIFFERENT from each other.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser origins allowed to call this API (comma-separated).
# If unset, falls back to PROD_FRONTEND_URL (production) / DEV_FRONTEND_URL (otherwise).
CLIENT_ORIGIN=http://localhost:5174
PROD_FRONTEND_URL=
DEV_FRONTEND_URL=http://localhost:5174

# Refresh cookie SameSite: strict | lax | none.
# Default: "none" in production (works when the site and API are on different
# domains, e.g. Vercel + Railway; requires HTTPS), "lax" otherwise.
# Use "strict" only if the site and the API share one registrable domain.
# COOKIE_SAME_SITE=

# Optional tuning
# BCRYPT_COST=12
# AUTH_RATE_LIMIT_MAX=10

# One-time migration only (scripts/migrate-to-multi-user.js). Remove afterwards.
# The password is read from here, never from the repo.
MIGRATION_OWNER_USERNAME=chrstphrvllrn
MIGRATION_OWNER_PASSWORD=
